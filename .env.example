# SkillGuide Environment Variables Example
# Duplicate this file to .env for local testing or configure these in Vercel / Supabase.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL.

# Flask Application Secret Key for session signing
SECRET_KEY=

# Database Connection URL (Supabase PostgreSQL in production, or leave empty for local SQLite)
DATABASE_URL=

# Environment ('production' or 'development')
APP_ENV=
FLASK_ENV=

# Optional: Initial Administrator Credentials for Seeding (Leave empty to use defaults or create via UI)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
